# ===== 衡枢 全栈环境变量 =====
# 复制为 .env 后按环境修改。所有敏感值只允许经环境变量注入（方案书 v1.2 决策）。

# --- 控制台 ---
ADMIN_USERNAME=admin
# argon2 哈希：python scripts/gen_admin_hash.py '你的密码' 生成
ADMIN_PASSWORD_HASH=
# JWT 签名密钥（生产必须随机）：python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-insecure-secret-change-me
# 控制台监听
CONSOLE_HOST=0.0.0.0
CONSOLE_PORT=8080

# --- Router（数据面 API 网关） ---
ROUTER_HOST=0.0.0.0
ROUTER_PORT=9000
# 网关对外签发的 API Key（演示用；生产走多租户表）
ROUTER_API_KEY=demo-api-key

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- 凭证主密钥（派生 AES-GCM 密钥加密节点 SSH 凭证，控制台/Router/Agent 共用） ---
# 生产必须随机且三组件一致：python -c "import secrets;print(secrets.token_urlsafe(48))"
MASTER_KEY=dev-only-insecure-master-change-me

# --- Agent（节点上） ---
AGENT_HOST=0.0.0.0
AGENT_PORT=9100
NODE_ID=gpu-node-a
HEARTBEAT_INTERVAL=3
